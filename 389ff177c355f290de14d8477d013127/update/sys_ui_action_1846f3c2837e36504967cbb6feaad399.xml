        <script><![CDATA[function openExecution() {
	const dd = new GlideModal('hierarchical_progress_viewer', false, '40em', '10em');

	const node = g_list.getCell(g_sysId, 'term');
	const term = node && node.textContent;
	if (term) {
		dd.setTitle('Code Search for \'' + term + '\'');
	} else {
		// term column not present on the list
		dd.setTitle('Code Search');
	}

	dd.setPreference('sysparm_renderer_execution_id', g_sysId);
	dd.render();
}]]></script>
